text = "The rules"

[node name="RulesBody" type="Label" parent="Scroll/Margin/Content"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 15
text = "Light Up is played on a grid of black and white cells. Your goal is to place light bulbs on white cells so that every white cell is lit.\n\nA bulb lights every cell in its row and column, in all four directions, until a black cell (or the edge of the grid) blocks the light.\n\nNo bulb may light up another bulb. If two bulbs can see each other, that's not allowed.\n\nSome black cells have a number in them. That number tells you exactly how many bulbs must be placed on the white cells directly touching that black cell's edges (up, down, left, right) -- no more, no fewer.\n\nThe puzzle is solved once every white cell is lit, no two bulbs see each other, and every numbered black cell has exactly the right number of bulbs next to it.\n\nWatch out: leaving two bulbs lighting each other unresolved for 5 seconds spawns an enemy at the conflict, and another every 5 seconds it stays unresolved. Enemies walk toward the nearest player and attack when adjacent. Solving the puzzle clears every enemy on the board.\n\nEach level also has a 5-minute clock. If it runs out while any tile is still unlit, a boss spawns with 50 health -- it can melee when adjacent or shoot at range along a clear row or column, but its ranged attack can't go through walls. Correctly satisfying a numbered clue adds 30 seconds to that clock the first time you get it right, so careful, correct play buys you breathing room."
autowrap_mode = 2

[node name="Spacer1" type="Control" parent="Scroll/Margin/Content"]
custom_minimum_size = Vector2(0, 16)
layout_mode = 2

[node name="ControlsHeading" type="Label" parent="Scroll/Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Controls"

[node name="ControlsBody" type="Label" parent="Scroll/Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 15
text = "{move_up}/{move_left}/{move_down}/{move_right}  --  walk your player character around the grid, one cell at a time. Black cells are walls -- you can't walk through them.\n\n{place_light}  --  place a bulb at your feet, or pick it back up if one's already there.\n\n{attack}  --  attack an enemy in an adjacent cell (5 damage; normal enemies have 10 health so two hits clears one, the boss has 50).\n\n{block} (hold)  --  block: takes 25% less melee damage and no ranged damage while held, but you can't attack while blocking.\n\nF11  --  toggle fullscreen, any time.\n\nEscape  --  pause menu (singleplayer only pauses countdowns; in multiplayer it's just your own local menu). Movement, placing a light, attacking, and blocking can all be rebound from the Settings screen.\n\nYou have 100 health. A normal enemy deals 5 damage per hit when adjacent; the boss deals 10 melee or 5 at range. If your health reaches 0 you're defeated and can't act -- in multiplayer you respawn after 10 seconds as long as at least one teammate is still standing; if everyone is defeated at once, only a Reset brings the board back. In singleplayer a defeat needs a Reset too.\n\nIn multiplayer, everyone shares one board and moves independently with their own controls -- your own avatar has a white ring around it so you can tell it apart from your teammates'."
autowrap_mode = 2

[node name="Spacer2" type="Control" parent="Scroll/Margin/Content"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2

[connection signal="pressed" from="BackButton" to="." method="_on_back_pressed"]
