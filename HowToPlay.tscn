[node name="ControlsBody" type="Label" parent="Scroll/Margin/Content" unique_id=1772556937]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 15
text = "{move_up}/{move_left}/{move_down}/{move_right}  --  walk your player character around the grid, one cell at a time. Black cells are walls -- you can't walk through them.

{place_light}  --  place a light at your feet, or pick it back up if one's already there.

{attack}  --  attack an enemy in an adjacent cell.

{block} (hold)  --  block: takes less melee damage and no ranged damage while held, but you can't attack while blocking.

F11  --  toggle fullscreen, any time.

Escape  --  pause menu (singleplayer only pauses countdowns; in multiplayer it's just your own local menu). Movement, placing a light, attacking, and blocking can all be rebound from the Settings screen.

You have 100 health. If your health reaches 0 you're defeated and can't act. In singleplayer you can Reset the board and Try Again -- in multiplayer you respawn after 10 seconds as long as at least one teammate is still standing; if everyone is defeated at once, Reset the board to Try Again.

In multiplayer, everyone shares one board and moves independently with their own controls -- your own avatar has a white ring around it so you can tell it apart from your teammates'."
autowrap_mode = 2

