[node name="RulesBodyContinued" type="Label" parent="Scroll/Margin/Content"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 15
text = "No light may light up another light. If two lights can see each other, that's not allowed.

Watch out: leaving two lights lighting each other for 5 seconds spawns an enemy at the conflict, and another every 5 seconds that stays unresolved. Enemies walk toward the nearest player and attack when adjacent.

Each level also has a 5-minute clock. If it runs out while any floor tile is still unlit, a boss spawns -- it can melee when adjacent or shoot at range along a clear row or column, but its ranged attack can't go through walls. Correctly satisfying a numbered clue adds 30 seconds to that clock the first time you get it right, so careful, correct play buys you breathing room.

Solving the puzzle clears every enemy on the board.

The puzzle is solved once every floor cell is lit, no two lights see each other, and every numbered wall cell has exactly the right number of lights next to it."
autowrap_mode = 2

