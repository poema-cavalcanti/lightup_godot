[node name="RulesBody" type="Label" parent="Scroll/Margin/Content" unique_id=1046063290]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 15
text = "Light Up is played on a grid of floor and wall cells. Your goal is to place lights on floor cells so that every floor cell is lit.

A light lights every floor cell in its row and column, in all four directions, until a wall cell (or the edge of the grid) blocks the light.

Some walls have a number of light holders in them. That number tells you exactly how many lights must be placed on the floor cells directly touching that wall cell's edges (up, down, left, right) -- no more, no fewer. If there is a cloth with a NO symbol covering the wall then no lights must be placed directly touching that wall cell's edges."
autowrap_mode = 2

